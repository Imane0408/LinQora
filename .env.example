APP_NAME=LinQora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Base de données ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linqora
DB_USERNAME=root
DB_PASSWORD=

# ─── Mail (Gmail SMTP — App Password) ────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emmarharib@gmail.com
MAIL_PASSWORD="inxn weej rfhu vpuu"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=emmarharib@gmail.com
MAIL_FROM_NAME="LinQora"

# ─── Queue (pour envoi email en arrière-plan) ─────────────────────────────────
QUEUE_CONNECTION=database

# ─── Cache & Session ──────────────────────────────────────────────────────────
CACHE_DRIVER=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Sanctum (CORS frontend React) ───────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ─── QR Code ──────────────────────────────────────────────────────────────────
QR_CODE_SIZE=300
QR_CODE_MARGIN=2
